{
  "info": {
    "name": "CRM Backend - Postman",
    "description": "Colección construida a partir de los controladores y DTO del ZIP crmProject. Base local predeterminada: http://localhost:3000/api. Algunas rutas no tienen guard de autenticación declarado en los controladores del ZIP; el token se guarda para pruebas y futuras rutas protegidas. Ejecuta primero Login y después crea un contacto y usuario de prueba antes de probar las rutas dependientes de IDs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "username",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "contactId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "ticketId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "tagId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "socialProfileId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 - Inicio y autenticación",
      "item": [
        {
          "name": "Health check / raíz",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api",
              "host": [
                "localhost"
              ],
              "protocol": "http",
              "port": "3000",
              "path": [
                "api"
              ]
            },
            "description": "Controlador raíz de NestJS. Puede devolver texto plano."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/auth/login",
              "host": [
                "localhost"
              ],
              "protocol": "http",
              "port": "3000",
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Guarda data.access_token en la variable access_token y el ID del usuario autenticado, si existen.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('La petición responde correctamente', function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
                  "const json = pm.response.json();",
                  "if (json && json.success && json.data && json.data.access_token) {",
                  "  pm.collectionVariables.set('access_token', json.data.access_token);",
                  "  if (json.data.user && json.data.user.id) pm.collectionVariables.set('userId', String(json.data.user.id));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
